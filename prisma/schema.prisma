// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comprador {
  id                String   @id @default(uuid())
  email             String   @unique
  senhaHash         String   @map("senha_hash")
  nomeCompleto      String   @map("nome_completo")
  telefonePessoal   String   @map("telefone_pessoal")
  whatsappPessoal   String   @map("whatsapp_pessoal")
  cnpj              String
  razaoSocial       String   @map("razao_social")
  nomeFantasia      String?  @map("nome_fantasia")
  telefoneComercial String   @map("telefone_comercial")
  whatsappComercial String   @map("whatsapp_comercial")
  website           String?
  redeSocial        String?  @map("rede_social")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("compradores")
}

model Fornecedor {
  id                    String   @id @default(uuid())
  email                 String   @unique
  senhaHash             String   @map("senha_hash")
  telefone              String
  whatsapp              String
  cnpj                  String
  razaoSocial           String   @map("razao_social")
  nomeFantasia          String   @map("nome_fantasia")
  website               String
  redeSocial            String   @map("rede_social")
  cidade                String
  estado                String
  tipoInscricao         String   @map("tipo_inscricao")
  numeroInscricao       String   @map("numero_inscricao")
  tipoEmpresa           String   @map("tipo_empresa")
  categoriasProdutos    Json     @map("categorias_produtos")
  descricaoInstitucional String  @map("descricao_institucional")
  portfolioUrls         Json     @default("[]") @map("portfolio_urls")
  formaPagamento        String   @map("forma_pagamento")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("fornecedores")
}

model Profissional {
  id                    String   @id @default(uuid())
  cpf                   String   @unique
  senhaHash             String   @map("senha_hash")
  nomeCompleto          String   @map("nome_completo")
  apelido               String
  telefonePessoal       String   @map("telefone_pessoal")
  whatsappPessoal       String   @map("whatsapp_pessoal")
  emailPessoal          String   @unique @map("email_pessoal")
  website               String?
  redeSocial            String?  @map("rede_social")
  tipoEmpresa           String   @map("tipo_empresa")
  categoriasProdutos    Json     @map("categorias_produtos")
  descricaoInstitucional String  @map("descricao_institucional")
  portfolioUrls         Json     @default("[]") @map("portfolio_urls")
  formaPagamento        String   @map("forma_pagamento")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("profissionais")
}

model Plano {
  id          String       @id @default(uuid())
  nome        String       @unique
  valor           Decimal  @db.Decimal(10, 2)
  limiteProdutos  Int      @default(0) @map("limite_produtos")
  createdAt       DateTime @default(now()) @map("created_at")
  assinaturas     Assinatura[]

  @@map("planos")
}

model Assinatura {
  id          String   @id @default(uuid())
  planoId     String   @map("plano_id")
  plano       Plano    @relation(fields: [planoId], references: [id])
  usuarioId   String   @map("usuario_id")
  tipoUsuario String   @map("tipo_usuario")
  status      String   @default("Pendente")
  vencimento  DateTime
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([usuarioId, tipoUsuario])
  @@map("assinaturas")
}

model Collaborator {
  id                String    @id @default(uuid())
  email             String    @unique
  senhaHash         String?   @map("senha_hash")
  nome              String
  role              String    @default("suporte")
  inviteToken       String?   @unique @map("invite_token")
  inviteAcceptedAt  DateTime? @map("invite_accepted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("collaborators")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}
